# ===== Server =====
NODE_ENV=development
PORT=5000
# Comma separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:4200

# ===== Database =====
# Leave MONGODB_URI empty to automatically boot an in-memory MongoDB
# (great for local development and demos). For real data set e.g.:
# MONGODB_URI=mongodb://127.0.0.1:27017/parking_management
MONGODB_URI=

# ===== Auth =====
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
COOKIE_MAX_AGE_MS=86400000

# ===== Rate limiting =====
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
